[Unit]
Description=Restore tmux sessions on login
After=default.target

[Service]
Type=oneshot
# Start a headless tmux server if none is running, then restore sessions.
# The server stays alive in the background; attach with: tmux attach
ExecStart=/bin/bash -c 'tmux start-server; /usr/bin/tmuxsaver restore --quiet'
# CRITICAL: a plain oneshot uses KillMode=control-group, which kills *every*
# process in the unit's cgroup the instant ExecStart exits — including the tmux
# server we just started. The server would be reaped before anyone can attach,
# so "nothing is restored on boot". KillMode=process only signals the main
# process (already gone), and RemainAfterExit keeps the unit active so the
# cgroup is not torn down. Together they let the tmux daemon survive.
RemainAfterExit=yes
KillMode=process

[Install]
WantedBy=default.target
