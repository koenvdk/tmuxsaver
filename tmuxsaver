#!/usr/bin/env bash
# tmuxsaver - minimal tmux session saver
# Saves working directory and bash/zsh history per session.
# No windows, panes, or running programs are preserved.
#
# Usage: tmuxsaver <command> [options]
#   setup             Set up tmuxsaver for your user (run once, as yourself)
#   unsetup           Undo `setup` (saved sessions are kept)
#   save              Save all current tmux sessions
#   restore           Restore previously saved sessions
#   list              List saved sessions
#   forget <name>...  Remove saved data for one or more sessions
#   clean             Remove all saved session data
#   setup-shell       Print the shell integration snippet
#   setup-tmux        Add only the save-on-detach hook to ~/.tmux.conf
#
# Options:
#   --dir <path>      Override save directory (default: ~/.tmuxsaver)
#   --quiet, -q       Suppress informational output
#   --no-shell-hook   setup: skip ~/.bashrc / ~/.zshrc
#   --no-tmux-hook    setup: skip ~/.tmux.conf
#   --no-systemd      setup: skip the systemd user services
#   --no-linger       setup: don't enable lingering
#   --version, -v     Print the version

set -uo pipefail

# Everything tmuxsaver writes (history, working directories, session names)
# is private to the user.
umask 077

TMUXSAVER_VERSION="0.5.2"
SAVE_DIR="${TMUXSAVER_DIR:-$HOME/.tmuxsaver}/sessions"
QUIET=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

log()  { if [[ $QUIET -eq 0 ]]; then echo "$*" >&2; fi; }
info() { log "[tmuxsaver] $*"; }
warn() { echo "[tmuxsaver] WARNING: $*" >&2; }
die()  { echo "[tmuxsaver] ERROR: $*" >&2; exit 1; }

# Session name <-> directory name. tmux allows "/" in session names (it only
# rewrites "." and ":"), so store names percent-encoded: "%" -> %25 and
# "/" -> %2F. The shell hook in shell/tmuxsaver.sh encodes the same way.
encode_name() { local n=${1//\%/%25}; printf '%s' "${n//\//%2F}"; }
decode_name() { local n=${1//%2F//}; printf '%s' "${n//%25/%}"; }

# Identity of a live session that survives a rename: server pid, session id
# and creation time. Used by save to recognise a renamed session.
session_identity() {
    tmux display-message -t "=$1:" -p '#{pid}:#{session_id}:#{session_created}' 2>/dev/null
}

# Saved-session directories, skipping the links left behind by renames.
saved_session_dirs() {
    local d
    for d in "$SAVE_DIR"/*/; do
        d="${d%/}"
        [[ -d "$d" && ! -L "$d" ]] && printf '%s\n' "$d"
    done
}

# Put a renamed session's saved data (already moved aside to $1) under its
# new name $2, then leave a link at its old encoded name $3.
# The destination may be a link left by an earlier rename (e.g. renaming
# work -> proj -> work): the link is replaced, never followed. It may also be
# a real directory belonging to another saved session: then both histories
# are kept, not overwritten.
place_renamed() {
    local staged=$1 new_name=$2 old_enc=$3
    local new_enc new_dir
    new_enc=$(encode_name "$new_name")
    new_dir="$SAVE_DIR/$new_enc"
    [[ -L "$new_dir" ]] && rm -f "$new_dir"
    if [[ -d "$new_dir" ]]; then
        if [[ -f "$staged/history" ]]; then
            local tmp
            tmp=$(mktemp) || return 1
            { cat "$staged/history"; [[ -f "$new_dir/history" ]] && cat "$new_dir/history"; } > "$tmp"
            cat "$tmp" > "$new_dir/history"
            rm -f "$tmp"
        fi
        rm -rf "$staged"
    else
        mv "$staged" "$new_dir"
    fi
    # Shells started before the rename still have HISTFILE pointing into the
    # old directory; through the link their history keeps landing here. Only
    # when the old name isn't in use again (e.g. two sessions swapped names).
    if [[ ! -e "$SAVE_DIR/$old_enc" && ! -L "$SAVE_DIR/$old_enc" ]]; then
        ln -s "$new_enc" "$SAVE_DIR/$old_enc"
    fi
    info "Session '$(decode_name "$old_enc")' was renamed to '$new_name'; moved its saved data"
}

# ---------------------------------------------------------------------------
# Save
# ---------------------------------------------------------------------------

cmd_save() {
    command -v tmux &>/dev/null || die "tmux is not installed or not in PATH"

    # No server means nothing to save — not an error. The logout service and
    # the detach hook both run save when there may be no server left.
    local sessions
    sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null) || {
        info "No tmux server running; nothing to save."
        return 0
    }

    mkdir -p "$SAVE_DIR"
    # Older versions created this with the default umask (often group- or
    # world-readable); history can contain secrets.
    chmod 700 "$SAVE_DIR"

    # Renamed sessions: a saved directory whose recorded identity belongs to
    # a live session with a different name is that session's old name.
    local -A live_by_id=()
    local session id
    while IFS= read -r session; do
        [[ -n "$session" ]] || continue
        id=$(session_identity "$session") && live_by_id[$id]=$session
    done <<< "$sessions"
    local dir saved_id
    local -a renamed_dirs=() renamed_to=()
    while IFS= read -r dir; do
        [[ -f "$dir/id" ]] || continue
        saved_id=$(cat "$dir/id")
        [[ -n "${live_by_id[$saved_id]:-}" ]] || continue
        [[ "$(basename "$dir")" == "$(encode_name "${live_by_id[$saved_id]}")" ]] && continue
        renamed_dirs+=("$dir")
        renamed_to+=("${live_by_id[$saved_id]}")
    done < <(saved_session_dirs)
    # Two phases, so renames that touch each other (a<->b swaps, renaming
    # back to an earlier name) never overwrite data still waiting to move:
    # first move every renamed directory aside, then place each one.
    if [[ ${#renamed_dirs[@]} -gt 0 ]]; then
        local stage i
        stage=$(mktemp -d "$SAVE_DIR/.renaming.XXXXXX") || die "cannot create $SAVE_DIR/.renaming.*"
        for i in "${!renamed_dirs[@]}"; do
            mv "${renamed_dirs[$i]}" "$stage/$i"
        done
        for i in "${!renamed_dirs[@]}"; do
            place_renamed "$stage/$i" "${renamed_to[$i]}" "$(basename "${renamed_dirs[$i]}")"
        done
        rmdir "$stage"
    fi
    # Links whose target was forgotten are dead weight.
    for dir in "$SAVE_DIR"/*; do
        [[ -L "$dir" && ! -e "$dir" ]] && rm -f "$dir"
    done

    local count=0
    local missing_history=()

    while IFS= read -r session; do
        [[ -z "$session" ]] && continue

        local session_dir
        session_dir="$SAVE_DIR/$(encode_name "$session")"
        mkdir -p "$session_dir"

        # Working directory: use the most recently active pane.
        # "=name:" forces an exact session match — a bare name would also
        # match any session it is a prefix of (e.g. "work" → "workbench").
        local workdir
        workdir=$(tmux display-message -t "=$session:" -p '#{pane_current_path}' 2>/dev/null) || continue
        echo "$workdir" > "$session_dir/workdir"
        session_identity "$session" > "$session_dir/id"

        local histfile="$session_dir/history"
        if [[ -f "$histfile" ]]; then
            info "Saved session '$session': $workdir (history present)"
        else
            info "Saved session '$session': $workdir (no per-session history yet)"
            missing_history+=("$session")
        fi

        count=$(( count + 1 ))
    done <<< "$sessions"

    info "Saved $count session(s) to $SAVE_DIR"

    # A missing history file means the session's shell isn't writing to the
    # per-session path yet. New shells pick this up automatically once the
    # tmuxsaver hook is in ~/.bashrc; existing shells need a one-time flush.
    # NOTE: `tmuxsaver setup-shell` only PRINTS the hook snippet — it can't
    # create history for a live shell, so we do not point users there.
    if [[ ${#missing_history[@]} -gt 0 ]] && [[ $QUIET -eq 0 ]]; then
        warn "No per-session history file for: ${missing_history[*]}"
        warn "New panes record history automatically once the hook is in ~/.bashrc."
        warn "To capture an existing session's current history, run INSIDE its pane:"
        warn "    export HISTFILE=\"$SAVE_DIR/<session>/history\"   # <session> as listed above"
        warn "    mkdir -p \"\$(dirname \"\$HISTFILE\")\" && history -w"
    fi
}

# ---------------------------------------------------------------------------
# Restore
# ---------------------------------------------------------------------------

cmd_restore() {
    command -v tmux &>/dev/null || { warn "tmux is not installed"; return 0; }
    tmux list-sessions &>/dev/null || tmux start-server

    [[ -d "$SAVE_DIR" ]] || {
        info "No saved sessions found at $SAVE_DIR"
        return 0
    }

    local count=0

    local session_dir
    while IFS= read -r session_dir; do
        local session
        session=$(decode_name "$(basename "$session_dir")")
        local workdir_file="$session_dir/workdir"
        local histfile="$session_dir/history"

        # "=name" forces an exact match; a bare name prefix-matches, so a
        # live "workbench" would make us skip restoring a saved "work".
        if tmux has-session -t "=$session" 2>/dev/null; then
            info "Session '$session' already exists — skipping"
            continue
        fi

        # A session with no workdir file (or one whose directory no longer
        # exists) is still worth restoring — fall back to $HOME rather than
        # skipping it entirely.
        local workdir="$HOME"
        if [[ -f "$workdir_file" ]]; then
            workdir=$(cat "$workdir_file")
        else
            warn "No saved workdir for session '$session'; restoring at \$HOME"
        fi

        if [[ ! -d "$workdir" ]]; then
            warn "Saved workdir '$workdir' for session '$session' no longer exists; using \$HOME"
            workdir="$HOME"
        fi

        # Hand the saved history file to the new shell through its
        # environment. The shell reads HISTFILE when it starts, so the very
        # first Up-arrow already shows the last command — in bash and zsh
        # alike, with or without the ~/.bashrc hook (which computes the same
        # path). Earlier versions typed `export HISTFILE=…; history -c;
        # history -r` into the pane instead: that echoed into every restored
        # session, and zsh has no `history -c`.
        # The variable lives in the session environment, so later windows
        # and panes in this session pick up the same history file too.
        local env_args=()
        [[ -f "$histfile" ]] && env_args=(-e "HISTFILE=$histfile")
        # A custom save dir (--dir / TMUXSAVER_DIR) must reach the shell hook
        # too, or it would point HISTFILE back at the default location.
        [[ -n "${TMUXSAVER_DIR:-}" ]] && env_args+=(-e "TMUXSAVER_DIR=$TMUXSAVER_DIR")

        tmux new-session -d -s "$session" -c "$workdir" ${env_args[@]+"${env_args[@]}"}

        info "Restored session '$session' at $workdir"
        count=$(( count + 1 ))
    done < <(saved_session_dirs)

    info "Restored $count session(s)"
}

# ---------------------------------------------------------------------------
# List
# ---------------------------------------------------------------------------

cmd_list() {
    [[ -d "$SAVE_DIR" ]] || { echo "No saved sessions."; return 0; }

    local found=0 session_dir
    while IFS= read -r session_dir; do
        local session
        session=$(decode_name "$(basename "$session_dir")")
        local workdir="(unknown)"
        [[ -f "$session_dir/workdir" ]] && workdir=$(cat "$session_dir/workdir")
        local has_history="no"
        [[ -f "$session_dir/history" ]] && has_history="yes"
        printf "  %-20s  %s  (history: %s)\n" "$session" "$workdir" "$has_history"
        found=$(( found + 1 ))
    done < <(saved_session_dirs)

    [[ $found -eq 0 ]] && echo "No saved sessions."
}

# ---------------------------------------------------------------------------
# Clean
# ---------------------------------------------------------------------------

cmd_clean() {
    [[ -d "$SAVE_DIR" ]] || { info "Nothing to clean."; return 0; }

    if [[ $QUIET -eq 0 ]]; then
        read -r -p "[tmuxsaver] Remove all saved session data at $SAVE_DIR? [y/N] " answer
        [[ "$answer" =~ ^[Yy]$ ]] || { info "Aborted."; return 0; }
    fi

    rm -rf "$SAVE_DIR"
    info "Cleaned $SAVE_DIR"
}

# ---------------------------------------------------------------------------
# Forget — remove saved data for specific sessions (not all of them)
# ---------------------------------------------------------------------------

cmd_forget() {
    [[ ${#FORGET_TARGETS[@]} -gt 0 ]] || \
        die "forget requires at least one session name (see 'tmuxsaver list')"

    [[ -d "$SAVE_DIR" ]] || { info "No saved sessions to forget."; return 0; }

    local removed=0
    for name in "${FORGET_TARGETS[@]}"; do
        # Names are encoded ("/" -> %2F), so only "." and ".." could escape
        # SAVE_DIR; tmux never creates those.
        if [[ "$name" == "." ]] || [[ "$name" == ".." ]] || [[ -z "$name" ]]; then
            warn "Invalid session name: '$name'"
            continue
        fi

        local enc dir
        enc=$(encode_name "$name")
        dir="$SAVE_DIR/$enc"
        if [[ -d "$dir" ]]; then
            rm -rf "$dir"
            # Drop the links earlier names of this session left behind.
            find "$SAVE_DIR" -maxdepth 1 -type l -lname "$enc" -delete
            info "Forgot saved session '$name'"
            removed=$(( removed + 1 ))
        else
            warn "No saved session named '$name' (see 'tmuxsaver list')"
        fi
    done

    info "Removed $removed saved session(s)"
}

# ---------------------------------------------------------------------------
# Integration helpers (shared by setup, unsetup, setup-shell, setup-tmux)
# ---------------------------------------------------------------------------

TMUX_HOOK_MARKER="# tmuxsaver: save on detach"

# Path of the shell integration snippet: next to the binary first
# (<prefix>/bin → <prefix>/share, as laid out by install.sh, `make install`
# and the .deb), then /usr/share, then the git checkout.
find_snippet() {
    local bin_dir candidate
    bin_dir="$(dirname "$(realpath "$0")")"
    for candidate in \
        "$bin_dir/../share/tmuxsaver/tmuxsaver.sh" \
        "/usr/share/tmuxsaver/tmuxsaver.sh" \
        "$bin_dir/shell/tmuxsaver.sh"; do
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    warn "shell integration snippet not found (looked under $bin_dir/../share/tmuxsaver)"
    return 1
}

# This binary's absolute path, for hooks that run with someone else's PATH.
self_path() { echo "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"; }

# Print rc file $1 with every tmuxsaver shell block removed — the current
# "# tmuxsaver:begin" … "# tmuxsaver:end" form and the old unterminated form
# that ran to its closing `fi` — and with trailing blank lines dropped.
# A block whose closing line is missing is kept as-is rather than taking the
# rest of the file with it.
strip_shell_hook() {
    awk '
        skip != "" {
            block = block $0 "\n"
            if ((skip == "end" && /^# tmuxsaver:end/) || (skip == "fi" && /^fi$/)) {
                skip = ""; block = ""
            }
            next
        }
        /^# tmuxsaver:begin/             { skip = "end"; block = $0 "\n"; next }
        /^# tmuxsaver shell integration/ { skip = "fi";  block = $0 "\n"; next }
        /^$/ { blank = blank "\n"; next }
        { printf "%s", blank; blank = ""; print }
        END { if (skip != "") printf "%s%s", blank, block }
    ' "$1"
}

# Print tmux.conf $1 without tmuxsaver's hook: a "# tmuxsaver:" marker line
# immediately followed by a set-hook line that runs tmuxsaver. Trailing blank
# lines are dropped.
strip_tmux_hook() {
    awk '
        held != "" {
            if (/^set-hook.*tmuxsaver/) { held = ""; next }
            printf "%s", blank; blank = ""; print held; held = ""
        }
        /^# tmuxsaver:/ { held = $0; next }
        /^$/ { blank = blank "\n"; next }
        { printf "%s", blank; blank = ""; print }
        END { if (held != "") { printf "%s", blank; print held } }
    ' "$1"
}

# Replace file $1's contents with stdin. Writing through the existing file
# (rather than swapping in a new one, as `sed -i` does) keeps its owner, mode
# and any symlink — e.g. a dotfile manager's ~/.bashrc — intact.
overwrite() {
    local tmp
    tmp=$(mktemp) || return 1
    cat > "$tmp" && cat "$tmp" > "$1"
    rm -f "$tmp"
}

has_shell_hook() {
    grep -qE '^# tmuxsaver:begin|^# tmuxsaver shell integration' "$1" 2>/dev/null
}

# rc files that should carry the shell hook. tmux starts *login* shells, and
# a login bash reads only the first of ~/.bash_profile, ~/.bash_login and
# ~/.profile. Stock setups have that file source ~/.bashrc; when it doesn't,
# the hook in ~/.bashrc would never run in tmux, so hook that file too.
shell_hook_targets() {
    local f
    for f in "$HOME/.bashrc" "$HOME/.zshrc"; do
        [[ -f "$f" ]] && echo "$f"
    done
    for f in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
        if [[ -f "$f" ]]; then
            grep -q 'bashrc' "$f" || echo "$f"
            break
        fi
    done
}

cmd_setup_shell() {
    local snippet
    snippet=$(find_snippet) || exit 1
    cat "$snippet"
}

setup_shell_hooks() {
    local snippet rc count=0
    snippet=$(find_snippet) || return 1
    while IFS= read -r rc; do
        [[ -n "$rc" ]] || continue
        # Idempotent: strip any existing block (old or new style), re-append.
        { strip_shell_hook "$rc"; echo; cat "$snippet"; } | overwrite "$rc"
        info "Shell hook installed in $rc"
        count=$(( count + 1 ))
    done < <(shell_hook_targets)
    if [[ $count -eq 0 ]]; then
        warn "No ~/.bashrc or ~/.zshrc found; add the hook yourself: tmuxsaver setup-shell >> <your rc file>"
    fi
}

remove_shell_hooks() {
    local rc
    for rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
        has_shell_hook "$rc" || continue
        strip_shell_hook "$rc" | overwrite "$rc"
        info "Shell hook removed from $rc"
    done
}

cmd_setup_tmux() {
    local tmux_conf="$HOME/.tmux.conf"
    # IMPORTANT: run-shell -b (background). A *synchronous* run-shell in the
    # client-detached hook blocks tmux's teardown and re-enters the server
    # (save calls tmux back), which can kill a pane's process on a graceful
    # disconnect (window close / logout). The -b form detaches the save from
    # the teardown path. Do not drop the -b.
    # Use this binary's absolute path: the hook runs with the tmux server's
    # PATH, which (e.g. for a server started by systemd) often lacks
    # ~/.local/bin, so a bare `tmuxsaver` would silently never run.
    local hookline
    hookline="set-hook -ga client-detached \"run-shell -b \\\"'$(self_path)' save --quiet || true\\\"\""

    # Idempotent and migrating: drop any existing tmuxsaver hook (including
    # the old synchronous form), then append the current one after exactly
    # one blank line.
    local existing=""
    [[ -f "$tmux_conf" ]] && existing=$(strip_tmux_hook "$tmux_conf")
    {
        [[ -n "$existing" ]] && printf '%s\n\n' "$existing"
        printf '%s\n%s\n' "$TMUX_HOOK_MARKER" "$hookline"
    } | overwrite "$tmux_conf"
    info "Save-on-detach hook installed in $tmux_conf"
    info "Reload a running server with: tmux source-file $tmux_conf"
}

remove_tmux_hook() {
    local tmux_conf="$HOME/.tmux.conf"
    [[ -f "$tmux_conf" ]] && grep -q tmuxsaver "$tmux_conf" || return 0
    strip_tmux_hook "$tmux_conf" | overwrite "$tmux_conf"
    # An empty tmux.conf is equivalent to none; `setup` usually created it.
    if ! grep -q '[^[:space:]]' "$tmux_conf"; then
        rm -f "$tmux_conf"
        info "Removed $tmux_conf (only held the tmuxsaver hook)"
    else
        info "Save-on-detach hook removed from $tmux_conf"
    fi
}

# True when this process can talk to the user's systemd manager (false under
# plain `su`/`sudo -u`, in containers, or without systemd).
have_user_systemd() {
    command -v systemctl &>/dev/null && systemctl --user show-environment &>/dev/null
}

setup_systemd() {
    if ! have_user_systemd; then
        warn "No systemd user manager reachable from this shell; skipping the services."
        warn "Re-run 'tmuxsaver setup' from a normal login session to enable save-on-logout / restore-on-login."
        return 0
    fi
    systemctl --user daemon-reload
    # The save unit does its work in ExecStop, so it must be running now for
    # a logout to trigger it. The restore unit only needs to start at login.
    if systemctl --user enable --now tmuxsaver-save.service &>/dev/null \
       && systemctl --user enable tmuxsaver-restore.service &>/dev/null; then
        info "Enabled tmuxsaver-save.service (save on logout) and tmuxsaver-restore.service (restore on login)"
    else
        warn "Could not enable the systemd user services (are the unit files installed?)"
    fi
}

remove_systemd() {
    have_user_systemd || return 0
    systemctl --user disable --now tmuxsaver-save.service tmuxsaver-restore.service &>/dev/null || true
    info "Disabled the tmuxsaver systemd user services"
}

# Lingering keeps the user's systemd manager — and the tmux server the
# restore service runs under it — alive after the last logout. Without it,
# live sessions die at logout (saved data is kept either way).
setup_linger() {
    local user="${USER:-$(id -un)}"
    command -v loginctl &>/dev/null || return 0
    if [[ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null)" == "yes" ]]; then
        info "Lingering is already enabled for $user"
        return 0
    fi
    if [[ -t 0 ]] && [[ $QUIET -eq 0 ]]; then
        local answer
        read -r -p "[tmuxsaver] Enable lingering so live tmux sessions survive a full logout? [Y/n] " answer || answer=y
        if [[ ! "${answer:-y}" =~ ^[Yy] ]]; then
            info "Skipped lingering. Enable it later with: loginctl enable-linger $user"
            return 0
        fi
    fi
    if loginctl enable-linger "$user" 2>/dev/null; then
        info "Enabled lingering for $user (undo: loginctl disable-linger $user)"
    else
        warn "Could not enable lingering; ask an admin to run: sudo loginctl enable-linger $user"
    fi
}

cmd_setup() {
    [[ $EUID -ne 0 ]] || warn "Running setup as root configures root's own account; run it as your normal user."
    [[ $DO_SHELL   -eq 1 ]] && setup_shell_hooks
    [[ $DO_TMUX    -eq 1 ]] && cmd_setup_tmux
    [[ $DO_SYSTEMD -eq 1 ]] && setup_systemd
    [[ $DO_LINGER  -eq 1 ]] && [[ "${TMUXSAVER_NO_LINGER:-0}" != "1" ]] && setup_linger
    info "Setup complete. Open a new shell (or run 'exec \$SHELL') for the history hook to take effect."
    return 0
}

cmd_unsetup() {
    remove_shell_hooks
    remove_tmux_hook
    remove_systemd
    info "Lingering was left as-is (disable with: loginctl disable-linger ${USER:-$(id -un)})"
    [[ -d "$SAVE_DIR" ]] && info "Saved sessions kept in $SAVE_DIR (delete with: tmuxsaver clean)"
    return 0
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

# Print the header comment block (everything up to the first non-comment).
usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }

COMMAND=""
FORGET_TARGETS=()
DO_SHELL=1
DO_TMUX=1
DO_SYSTEMD=1
DO_LINGER=1

while [[ $# -gt 0 ]]; do
    case "$1" in
        save|restore|list|clean|forget|setup|unsetup|setup-shell|setup-tmux)
            COMMAND="$1"
            shift
            ;;
        --dir)
            [[ -n "${2:-}" ]] || die "--dir requires a path argument"
            SAVE_DIR="$2/sessions"
            export TMUXSAVER_DIR="$2"
            shift 2
            ;;
        --quiet|-q)
            QUIET=1
            shift
            ;;
        --no-shell-hook) DO_SHELL=0;   shift ;;
        --no-tmux-hook)  DO_TMUX=0;    shift ;;
        --no-systemd)    DO_SYSTEMD=0; shift ;;
        --no-linger)     DO_LINGER=0;  shift ;;
        --version|-v)
            echo "tmuxsaver $TMUXSAVER_VERSION"
            exit 0
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -*)
            die "Unknown option: $1 (try --help)"
            ;;
        *)
            # Positional args are session names for `forget`; anything else is
            # an error.
            if [[ "$COMMAND" == "forget" ]]; then
                FORGET_TARGETS+=("$1")
                shift
            else
                die "Unknown argument: $1 (try --help)"
            fi
            ;;
    esac
done

[[ -n "$COMMAND" ]] || { usage; exit 1; }

case "$COMMAND" in
    save)         cmd_save ;;
    restore)      cmd_restore ;;
    list)         cmd_list ;;
    forget)       cmd_forget ;;
    clean)        cmd_clean ;;
    setup)        cmd_setup ;;
    unsetup)      cmd_unsetup ;;
    setup-shell)  cmd_setup_shell ;;
    setup-tmux)   cmd_setup_tmux ;;
