#!/usr/bin/env bash
# tmuxsaver - minimal tmux session saver
# Saves working directory and bash/zsh history per session.
# No windows, panes, or running programs are preserved.
#
# Usage: tmuxsaver <command> [options]
#   save              Save all current tmux sessions
#   restore           Restore previously saved sessions
#   list              List saved sessions
#   forget <name>...  Remove saved data for one or more sessions
#   clean             Remove all saved session data
#   setup-shell       Print the shell integration snippet
#   setup-tmux        Add save-on-detach hook to ~/.tmux.conf
#
# Options:
#   --dir <path>  Override save directory (default: ~/.tmuxsaver)
#   --quiet       Suppress informational output

set -uo pipefail

TMUXSAVER_VERSION="0.4.15"
SAVE_DIR="${TMUXSAVER_DIR:-$HOME/.tmuxsaver}/sessions"
QUIET=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

log()  { if [[ $QUIET -eq 0 ]]; then echo "$*" >&2; fi; }
info() { log "[tmuxsaver] $*"; }
warn() { echo "[tmuxsaver] WARNING: $*" >&2; }
die()  { echo "[tmuxsaver] ERROR: $*" >&2; exit 1; }

require_tmux() {
    command -v tmux &>/dev/null || die "tmux is not installed or not in PATH"
    # Use list-sessions (== `tmux ls`) as the probe: `tmux info` can fail in
    # contexts without a TTY/target even when a server is running.
    tmux list-sessions &>/dev/null || die "no tmux server is running"
}

# ---------------------------------------------------------------------------
# Save
# ---------------------------------------------------------------------------

cmd_save() {
    require_tmux

    local sessions
    sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null) || {
        info "No active tmux sessions to save."
        return 0
    }

    mkdir -p "$SAVE_DIR"
    local count=0
    local missing_history=()

    while IFS= read -r session; do
        [[ -z "$session" ]] && continue

        local session_dir="$SAVE_DIR/$session"
        mkdir -p "$session_dir"

        # Working directory: use the most recently active pane.
        # "=name:" forces an exact session match — a bare name would also
        # match any session it is a prefix of (e.g. "work" → "workbench").
        local workdir
        workdir=$(tmux display-message -t "=$session:" -p '#{pane_current_path}' 2>/dev/null) || continue
        echo "$workdir" > "$session_dir/workdir"

        local histfile="$session_dir/history"
        if [[ -f "$histfile" ]]; then
            info "Saved session '$session': $workdir (history present)"
        else
            info "Saved session '$session': $workdir (no per-session history yet)"
            missing_history+=("$session")
        fi

        count=$(( count + 1 ))
    done <<< "$sessions"

    info "Saved $count session(s) to $SAVE_DIR"

    # A missing history file means the session's shell isn't writing to the
    # per-session path yet. New shells pick this up automatically once the
    # tmuxsaver hook is in ~/.bashrc; existing shells need a one-time flush.
    # NOTE: `tmuxsaver setup-shell` only PRINTS the hook snippet — it can't
    # create history for a live shell, so we do not point users there.
    if [[ ${#missing_history[@]} -gt 0 ]] && [[ $QUIET -eq 0 ]]; then
        warn "No per-session history file for: ${missing_history[*]}"
        warn "New panes record history automatically once the hook is in ~/.bashrc."
        warn "To capture an existing session's current history, run INSIDE its pane:"
        warn "    export HISTFILE=\"\$HOME/.tmuxsaver/sessions/\$(tmux display-message -p '#S')/history\""
        warn "    mkdir -p \"\$(dirname \"\$HISTFILE\")\" && history -w"
    fi
}

# ---------------------------------------------------------------------------
# Restore
# ---------------------------------------------------------------------------

cmd_restore() {
    command -v tmux &>/dev/null || { warn "tmux is not installed"; return 0; }
    tmux list-sessions &>/dev/null || tmux start-server

    [[ -d "$SAVE_DIR" ]] || {
        info "No saved sessions found at $SAVE_DIR"
        return 0
    }

    local count=0

    for session_dir in "$SAVE_DIR"/*/; do
        [[ -d "$session_dir" ]] || continue
        session_dir="${session_dir%/}"

        local session
        session=$(basename "$session_dir")
        local workdir_file="$session_dir/workdir"
        local histfile="$session_dir/history"

        # "=name" forces an exact match; a bare name prefix-matches, so a
        # live "workbench" would make us skip restoring a saved "work".
        if tmux has-session -t "=$session" 2>/dev/null; then
            info "Session '$session' already exists — skipping"
            continue
        fi

        # A session with no workdir file (or one whose directory no longer
        # exists) is still worth restoring — fall back to $HOME rather than
        # skipping it entirely.
        local workdir="$HOME"
        if [[ -f "$workdir_file" ]]; then
            workdir=$(cat "$workdir_file")
        else
            warn "No saved workdir for session '$session'; restoring at \$HOME"
        fi

        if [[ ! -d "$workdir" ]]; then
            warn "Saved workdir '$workdir' for session '$session' no longer exists; using \$HOME"
            workdir="$HOME"
        fi

        # Hand the saved history file to the new shell through its
        # environment. The shell reads HISTFILE when it starts, so the very
        # first Up-arrow already shows the last command — in bash and zsh
        # alike, with or without the ~/.bashrc hook (which computes the same
        # path). Earlier versions typed `export HISTFILE=…; history -c;
        # history -r` into the pane instead: that echoed into every restored
        # session, and zsh has no `history -c`.
        # The variable lives in the session environment, so later windows
        # and panes in this session pick up the same history file too.
        local env_args=()
        [[ -f "$histfile" ]] && env_args=(-e "HISTFILE=$histfile")

        tmux new-session -d -s "$session" -c "$workdir" ${env_args[@]+"${env_args[@]}"}

        info "Restored session '$session' at $workdir"
        count=$(( count + 1 ))
    done

    info "Restored $count session(s)"
}

# ---------------------------------------------------------------------------
# List
# ---------------------------------------------------------------------------

cmd_list() {
    [[ -d "$SAVE_DIR" ]] || { echo "No saved sessions."; return 0; }

    local found=0
    for session_dir in "$SAVE_DIR"/*/; do
        [[ -d "$session_dir" ]] || continue
        local session
        session=$(basename "$session_dir")
        local workdir="(unknown)"
        [[ -f "$session_dir/workdir" ]] && workdir=$(cat "$session_dir/workdir")
        local has_history="no"
        [[ -f "$session_dir/history" ]] && has_history="yes"
        printf "  %-20s  %s  (history: %s)\n" "$session" "$workdir" "$has_history"
        found=$(( found + 1 ))
    done

    [[ $found -eq 0 ]] && echo "No saved sessions."
}

# ---------------------------------------------------------------------------
# Clean
# ---------------------------------------------------------------------------

cmd_clean() {
    [[ -d "$SAVE_DIR" ]] || { info "Nothing to clean."; return 0; }

    if [[ $QUIET -eq 0 ]]; then
        read -r -p "[tmuxsaver] Remove all saved session data at $SAVE_DIR? [y/N] " answer
        [[ "$answer" =~ ^[Yy]$ ]] || { info "Aborted."; return 0; }
    fi

    rm -rf "$SAVE_DIR"
    info "Cleaned $SAVE_DIR"
}

# ---------------------------------------------------------------------------
# Forget — remove saved data for specific sessions (not all of them)
# ---------------------------------------------------------------------------

cmd_forget() {
    [[ ${#FORGET_TARGETS[@]} -gt 0 ]] || \
        die "forget requires at least one session name (see 'tmuxsaver list')"

    [[ -d "$SAVE_DIR" ]] || { info "No saved sessions to forget."; return 0; }

    local removed=0
    for name in "${FORGET_TARGETS[@]}"; do
        # Only a plain session name is valid — reject anything that could
        # escape SAVE_DIR (path separators or dot components).
        if [[ "$name" == */* ]] || [[ "$name" == "." ]] || [[ "$name" == ".." ]] || [[ -z "$name" ]]; then
            warn "Invalid session name: '$name'"
            continue
        fi

        local dir="$SAVE_DIR/$name"
        if [[ -d "$dir" ]]; then
            rm -rf "$dir"
            info "Forgot saved session '$name'"
            removed=$(( removed + 1 ))
        else
            warn "No saved session named '$name' (see 'tmuxsaver list')"
        fi
    done

    info "Removed $removed saved session(s)"
}

# ---------------------------------------------------------------------------
# Setup-shell
# ---------------------------------------------------------------------------

cmd_setup_shell() {
    # Look next to the binary first (<prefix>/bin → <prefix>/share, as laid
    # out by install.sh, `make install` and the .deb), then the git checkout.
    local bin_dir candidate
    bin_dir="$(dirname "$(realpath "$0")")"
    for candidate in \
        "$bin_dir/../share/tmuxsaver/tmuxsaver.sh" \
        "/usr/share/tmuxsaver/tmuxsaver.sh" \
        "$bin_dir/shell/tmuxsaver.sh"; do
        if [[ -f "$candidate" ]]; then
            cat "$candidate"
            return 0
        fi
    done
    die "shell integration snippet not found (looked under $bin_dir/../share/tmuxsaver)"
}

# ---------------------------------------------------------------------------
# Setup-tmux
# ---------------------------------------------------------------------------

cmd_setup_tmux() {
    local tmux_conf="$HOME/.tmux.conf"
    local marker="# tmuxsaver: save on detach"
    # IMPORTANT: run-shell -b (background). A *synchronous* run-shell in the
    # client-detached hook blocks tmux's teardown and re-enters the server
    # (save calls tmux back), which can kill a pane's process on a graceful
    # disconnect (window close / logout). The -b form detaches the save from
    # the teardown path. Do not drop the -b.
    # Use this binary's absolute path: the hook runs with the tmux server's
    # PATH, which (e.g. for a server started by systemd) often lacks
    # ~/.local/bin, so a bare `tmuxsaver` would silently never run.
    local self
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    local hookline="set-hook -ga client-detached \"run-shell -b \\\"'$self' save --quiet || true\\\"\""

    # Migrate in place: strip any existing tmuxsaver hook (including the old
    # synchronous form) before re-adding, so upgrades pick up the -b version.
    if [[ -f "$tmux_conf" ]] && grep -qF "$marker" "$tmux_conf"; then
        sed -i "\|$marker|,+1d" "$tmux_conf"
        info "Updating existing tmux hook in $tmux_conf"
    fi

    # Trim trailing blank lines so repeated runs don't accumulate them, then
    # re-append with exactly one separating blank line.
    while [[ -s "$tmux_conf" ]] && [[ -z "$(tail -n1 "$tmux_conf")" ]]; do
        sed -i '$d' "$tmux_conf"
    done

    printf '\n%s\n%s\n' "$marker" "$hookline" >> "$tmux_conf"
    info "Added save-on-detach hook to $tmux_conf"
    info "Reload now with: tmux source-file $tmux_conf"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

COMMAND=""
FORGET_TARGETS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        save|restore|list|clean|forget|setup-shell|setup-tmux)
            COMMAND="$1"
            shift
            ;;
        --dir)
            [[ -n "${2:-}" ]] || die "--dir requires a path argument"
            SAVE_DIR="$2/sessions"
            shift 2
            ;;
        --quiet|-q)
            QUIET=1
            shift
            ;;
        --version|-v)
            echo "tmuxsaver $TMUXSAVER_VERSION"
            exit 0
            ;;
        --help|-h)
            sed -n '2,13p' "$0"
            exit 0
            ;;
        -*)
            die "Unknown option: $1 (try --help)"
            ;;
        *)
            # Positional args are session names for `forget`; anything else is
            # an error.
            if [[ "$COMMAND" == "forget" ]]; then
                FORGET_TARGETS+=("$1")
                shift
            else
                die "Unknown argument: $1 (try --help)"
            fi
            ;;
    esac
done

[[ -n "$COMMAND" ]] || { sed -n '2,13p' "$0"; exit 1; }

case "$COMMAND" in
    save)         cmd_save ;;
    restore)      cmd_restore ;;
    list)         cmd_list ;;
    forget)       cmd_forget ;;
    clean)        cmd_clean ;;
    setup-shell)  cmd_setup_shell ;;
    setup-tmux)   cmd_setup_tmux ;;
esac
