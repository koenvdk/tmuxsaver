#!/bin/bash
set -e

# dpkg invokes this as `prerm <action> [...]`:
#   remove                → genuine uninstall
#   upgrade <new-version> → upgrade OR `apt install --reinstall`
#   failed-upgrade ...    → recovery path
# Only a genuine `remove` tears anything down. On upgrade/reinstall we must
# do nothing: users' setup and session data are preserved silently.
ACTION="${1:-remove}"
if [[ "$ACTION" != "remove" ]]; then
    exit 0
fi

# ── Legacy global service enablement (versions before 0.5.0) ─────────────────
if command -v systemctl &>/dev/null; then
    systemctl --global disable tmuxsaver-save.service    2>/dev/null || true
    systemctl --global disable tmuxsaver-restore.service 2>/dev/null || true
fi

# ── Undo `tmuxsaver setup` for the user running the removal ─────────────────
# Other users' setups can't be reached from here; their hooks become inert
# once the binary is gone, and `tmuxsaver unsetup` before removal cleans them.
if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    USER_UID=$(id -u "$SUDO_USER")

    # Run as the user, in their own environment, so files keep their owner
    # and `systemctl --user` reaches their manager when it is running.
    runuser -u "$SUDO_USER" -- env -i \
        HOME="$USER_HOME" USER="$SUDO_USER" LOGNAME="$SUDO_USER" PATH="/usr/bin:/bin" \
        XDG_RUNTIME_DIR="/run/user/$USER_UID" \
        /usr/bin/tmuxsaver unsetup 2>&1 | sed 's/^\[tmuxsaver\]/tmuxsaver:/' || true

    # ── Session data ──────────────────────────────────────────────────────────
    SESSION_DIR="$USER_HOME/.tmuxsaver"
    if [[ -d "$SESSION_DIR" ]]; then
        echo ""
        echo "tmuxsaver: saved session data found at $SESSION_DIR"
        # Only prompt on a real terminal. Without one (unattended apt,
        # DEBIAN_FRONTEND=noninteractive), `read` hits EOF and returns 1, which
        # under `set -e` aborts prerm and makes the package unremovable.
        # Default to keeping the data.
        answer=n
        if [[ -t 0 ]]; then
            read -r -p "Remove saved session data? [y/N] " answer || answer=n
        fi
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            rm -rf "$SESSION_DIR"
            echo "tmuxsaver: session data removed"
        else
            echo "tmuxsaver: session data kept at $SESSION_DIR"
        fi
    fi
fi

echo ""
