#!/bin/bash
set -e

# dpkg invokes this as `prerm <action> [...]`:
#   remove                → genuine uninstall
#   upgrade <new-version> → upgrade OR `apt install --reinstall`
#   failed-upgrade ...    → recovery path
# Only a genuine `remove` should tear down the integration and ask about the
# user's saved session data. On upgrade/reinstall we must do nothing: the
# incoming postinst reconciles services and hooks, and session data must be
# preserved silently. To wipe data during a reinstall, use the postinst's
# TMUXSAVER_PURGE_DATA=1 opt-in instead (see README "reinstallclean").
ACTION="${1:-remove}"
if [[ "$ACTION" != "remove" ]]; then
    exit 0
fi

# ── Disable and stop services ─────────────────────────────────────────────────
if command -v systemctl &>/dev/null; then
    systemctl --global disable tmuxsaver-save.service    2>/dev/null || true
    systemctl --global disable tmuxsaver-restore.service 2>/dev/null || true
    systemctl --user   stop    tmuxsaver-save.service    2>/dev/null || true
    systemctl --user   stop    tmuxsaver-restore.service 2>/dev/null || true
    systemctl --user   daemon-reload                     2>/dev/null || true
fi

if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)

    # ── Remove shell hook from rc files ──────────────────────────────────────
    for rcfile in "$USER_HOME/.bashrc" "$USER_HOME/.zshrc"; do
        [[ -f "$rcfile" ]] || continue
        python3 - "$rcfile" <<'PYEOF'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1])
content = p.read_text()
content = re.sub(r'\n# tmuxsaver:begin.*?# tmuxsaver:end\n', '\n', content, flags=re.DOTALL)
content = re.sub(r'\n# tmuxsaver shell integration.*?^fi\n', '\n', content, flags=re.DOTALL | re.MULTILINE)
p.write_text(content)
PYEOF
        echo "tmuxsaver: removed shell hook from $rcfile"
    done

    # ── Remove tmux.conf hook ─────────────────────────────────────────────────
    TMUX_CONF="$USER_HOME/.tmux.conf"
    if [[ -f "$TMUX_CONF" ]] && grep -qF "tmuxsaver" "$TMUX_CONF"; then
        python3 - "$TMUX_CONF" <<'PYEOF'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1])
content = p.read_text()
content = re.sub(r'\n# tmuxsaver:.*\nset-hook.*tmuxsaver.*\n', '\n', content)
p.write_text(content)
PYEOF
        echo "tmuxsaver: removed hook from $TMUX_CONF"
    fi

    # ── Remove manually installed binary if present ───────────────────────────
    for binpath in "$USER_HOME/.local/bin/tmuxsaver" "/usr/local/bin/tmuxsaver"; do
        if [[ -f "$binpath" ]]; then
            rm -f "$binpath"
            echo "tmuxsaver: removed $binpath"
        fi
    done

    # ── Session data ──────────────────────────────────────────────────────────
    SESSION_DIR="$USER_HOME/.tmuxsaver"
    if [[ -d "$SESSION_DIR" ]]; then
        echo ""
        echo "tmuxsaver: saved session data found at $SESSION_DIR"
        # Only prompt on a real terminal. Without one (unattended apt,
        # DEBIAN_FRONTEND=noninteractive), `read` hits EOF and returns 1, which
        # under `set -e` aborts prerm and makes the package unremovable.
        # Default to keeping the data.
        answer=n
        if [[ -t 0 ]]; then
            read -r -p "Remove saved session data? [y/N] " answer || answer=n
        fi
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            rm -rf "$SESSION_DIR"
            echo "tmuxsaver: session data removed"
        else
            echo "tmuxsaver: session data kept at $SESSION_DIR"
        fi
    fi
fi

echo ""
