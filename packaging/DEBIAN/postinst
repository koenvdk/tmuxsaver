#!/bin/bash
set -e

# The package installs files only. Per-user integration — the shell history
# hook, the tmux save-on-detach hook, the systemd user services and lingering
# — is `tmuxsaver setup`, which each user runs as themselves. This script
# never edits anyone's rc files.
#
# dpkg calls this as `postinst configure <old-version>`; <old-version> is
# empty on a fresh install.
OLD_VERSION="${2:-}"

if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)

    # ── Opt-in data purge ("reinstallclean") ─────────────────────────────────
    # A normal install/reinstall/upgrade never touches saved sessions. Pass
    # TMUXSAVER_PURGE_DATA=1 to deliberately wipe them, e.g.:
    #   sudo TMUXSAVER_PURGE_DATA=1 apt install --reinstall /tmp/tmuxsaver_*.deb
    if [[ "${TMUXSAVER_PURGE_DATA:-0}" == "1" ]] && [[ -d "$USER_HOME/.tmuxsaver" ]]; then
        rm -rf "$USER_HOME/.tmuxsaver"
        echo "tmuxsaver: purged saved session data (TMUXSAVER_PURGE_DATA=1)"
    fi

    # ── Remove from-source binaries that would shadow /usr/bin/tmuxsaver ─────
    # ~/.local/bin and /usr/local/bin are typically earlier in PATH than
    # /usr/bin, so a leftover copy from `./install.sh` keeps running after the
    # .deb is installed. Scrub them so the .deb's version always wins.
    for binpath in "$USER_HOME/.local/bin/tmuxsaver" "/usr/local/bin/tmuxsaver"; do
        if [[ -f "$binpath" ]] && [[ "$(realpath "$binpath" 2>/dev/null)" != "/usr/bin/tmuxsaver" ]]; then
            rm -f "$binpath"
            echo "tmuxsaver: removed shadowing copy at $binpath"
        fi
    done
fi

echo ""
if [[ -n "$OLD_VERSION" ]] && dpkg --compare-versions "$OLD_VERSION" lt 0.5.0; then
    # Versions before 0.5.0 set users up from this script and enabled the
    # services globally. That setup keeps working untouched; `tmuxsaver setup`
    # moves it to the per-user model (it is idempotent and safe to run).
    echo "tmuxsaver upgraded from $OLD_VERSION. Your existing setup keeps working."
    echo "Setup is now per user: run 'tmuxsaver setup' once as your normal user"
    echo "(not with sudo) to refresh your hooks and enable your own services."
else
    echo "tmuxsaver installed. Finish setting up by running, as your normal user"
    echo "(not with sudo):"
    echo ""
    echo "    tmuxsaver setup"
    echo ""
    echo "It adds the history hook to your shell rc files, a save-on-detach hook"
    echo "to ~/.tmux.conf, and enables save-on-logout / restore-on-login."
    echo "See 'tmuxsaver --help' for opt-outs; undo with 'tmuxsaver unsetup'."
fi
echo ""
